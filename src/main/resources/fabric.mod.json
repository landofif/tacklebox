{
  "schemaVersion": 1,
  "id": "dofisaddons",
  "version": "${version}",
  "name": "dofis addons",
  "description": "an addon for foecollab on fishonmc: chat triggers with your own titles and sounds, a quests left hud, chat boxes, bobber and world tweaks, and one settings screen for both mods. display only, no automation.",
  "authors": [
    "landofif"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.landofif.dofisaddons.DofisAddons"
    ],
    "modmenu": [
      "dev.landofif.dofisaddons.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dofisaddons.mixins.json"
  ],
  "accessWidener": "dofisaddons.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "foecollab": ">=3.0.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
