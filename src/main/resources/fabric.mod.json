{
  "schemaVersion": 1,
  "id": "dofisaddons",
  "version": "${version}",
  "name": "Dofi's Addons",
  "description": "fishonmc addons: chat triggers with your own titles and sounds, session and all-time fishing stats, custom huds and a bobber timer. display only, no automation.",
  "authors": ["landofif"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.landofif.dofisaddons.DofisAddons"],
    "modmenu": ["dev.landofif.dofisaddons.ModMenuIntegration"]
  },
  "mixins": ["dofisaddons.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.8.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
