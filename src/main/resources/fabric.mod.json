{
  "schemaVersion": 1,
  "id": "tacklebox",
  "version": "${version}",
  "name": "tacklebox",
  "description": "for fishonmc: chat triggers with your own titles and sounds, a quests left hud, chat boxes, bobber and world tweaks, and extras for foecollab when it is installed. it never fishes, sells or does quests for you.",
  "authors": [
    "landofif"
  ],
  "license": "MIT",
  "icon": "assets/tacklebox/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.landofif.tacklebox.Tacklebox"
    ],
    "modmenu": [
      "dev.landofif.tacklebox.ModMenuIntegration"
    ]
  },
  "mixins": [
    "tacklebox.mixins.json",
    "tacklebox.foecollab.mixins.json"
  ],
  "accessWidener": "tacklebox.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "foecollab": ">=3.0.0",
    "modmenu": "*"
  }
}
