{
  "schemaVersion": 1,
  "id": "dofisaddons",
  "version": "${version}",
  "name": "dofis addons",
  "description": "fishonmc addons: chat triggers with your own titles and sounds, session and all-time fishing stats, custom huds, a bobber timer and a system24 look for the whole game. display only, no automation.",
  "authors": [
    "landofif"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.landofif.dofisaddons.DofisAddons"
    ],
    "modmenu": [
      "dev.landofif.dofisaddons.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dofisaddons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
